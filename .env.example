# copy to .env

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leftover

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# restrict signups to one domain, e.g. school.edu
ALLOWED_EMAIL_DOMAIN=

TIMEZONE=America/New_York

# minutes a claim is held before it expires
HOLD_MINUTES=15

# new-food emails, off unless set to on
EMAIL_ALERTS=off
ALERT_BATCH_SIZE=25
RESEND_API_KEY=
EMAIL_FROM=Leftover <alerts@example.com>
BASE_URL=http://localhost:8000

# optional, sends request logs to Datadog
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=leftover
DD_ENV=dev
