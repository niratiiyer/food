# Copy this file to .env and fill it in. Never commit .env.

# Where Postgres lives. Locally this is your own machine; on Render it is set for you.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leftover

# Long random string used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Only emails ending in this domain can sign up (leave blank to allow anyone while testing).
ALLOWED_EMAIL_DOMAIN=

# Timezone used to show and read pickup times.
TIMEZONE=America/New_York

# How long a claim is held before it expires and the portion goes back up for grabs.
HOLD_MINUTES=15

# Email alerts about new food. Off by default; set to on (and fill in RESEND_API_KEY) to send them.
EMAIL_ALERTS=off

# How many students get emailed about each new listing (highest priority first).
ALERT_BATCH_SIZE=25

# Email. With RESEND_API_KEY blank, emails are printed to the terminal instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Leftover <alerts@example.com>

# The public address of the site, used for links inside emails.
BASE_URL=http://localhost:8000

# Optional: ship request logs to Datadog. Leave blank to only log to the terminal.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=leftover
DD_ENV=dev
